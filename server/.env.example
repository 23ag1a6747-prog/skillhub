# Local file database
# No database server or connection string is required.

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=development

# CORS - comma separated list of allowed origins
CLIENT_URL=http://localhost:5173

# Optional: seed script safety switch
ALLOW_SEED=true
